msgid "companyHistory"
msgstr "تاريخ الشركة"

msgid "companyHistory_txt"
msgstr "<p>تأسست الشركة الأم في عام 1988 وبعد أن تحقق نجاح العمل وتعددت الأنشطة انبثقت عنها (أميال التميز) لتكون أكثر تخصصا. تهدف الشركة إلى تقديم مشاريع داخلية وخدمات تأثيث وفقا لمعايير ومستويات المنظور المحلي والعالمي المتميز من خلال خبرة مستشاريها. طوّرت أميال الامتياز بنية جديدة لتنظيم المناسبات والمؤتمرات مع أفضل الموارد البشرية والتقنيات والخدمات ، بناءً على خبرتها السابقة ، بالإضافة إلى البحث والتطوير الذي يقدم خدمات إضافية ، بدءاً بالتصميم والتنفيذ ، والمشاركة في التحليل والتسويق للفعاليات وتوفير الخدمات الصوتية  والبصرية و الضيافة</p>"

msgid "chairman_message"
msgstr "كلمة رئيس مجلس الأدارة"

msgid "chairman_message_txt"
msgstr "السلام عليكم ورحمة الله وبركاته  <br/> لقد عملنا دوماً على تقديم أفضل الخدمات لعملائنا الكرام وتميزنا بقدرتنا على تطور ومواكبة الحداثة في النهضة العمرانية التي تشهدها المملكة وتوسعت أعمالنا لتغطي كافة أنحاء المملكة.<br/>ان بذلك بفضل الله ثم جهود الكادر الفني المتخصص لديكم حيث قدمتم كل ما يلزم للتوسع وتحقيق النجاح بتخصصكم في مجال الأعمال المدنية والديكور الداخلي والتأثيث.<br/>وعليه يسعدني ان تكونوا ضمن مجموعة العمل كيان مستقل متخصص بالأعمال المذكورة بمسمى (أميال التميز) وذلك لتميزكم الفعلي وحسن اداءكم طوال الفترة الماضية لتكون (أميال التميز) خدمة جديدة لعملائنا تواكب تطور متطلباتهم وتقدم أفضل ما يمكن لتحقيق المطلوب في تلبية حاجة العملاء.<br/>الصدق والأمانة عماد النجاح فيجب ان تحافظو عليهما لنبقى اهلاً للثقة التي عهدناها من عملائنا والمتابعة الحثيثة لطلبات العملاء والدقة في الإنجاز تجعلكم دوما على سلم النجاح.<br/>آملين أن نوفق وإياكم لما فيه خير العمل ونجاح"

