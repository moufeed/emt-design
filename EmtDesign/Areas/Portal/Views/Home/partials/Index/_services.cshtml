@{ 
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);

}

    <if include-if="ViewBag.services != null">

        <section class="s-pt-100 s-pt-lg-75 s-pb-lg-30 ds process-part  services-list s-parallax  overflow-visible" id="services">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-100">
                        <h2 class="animate fast" data-animation="fadeInLeft" data-appear-top-offset="250">@Localizer["latest_services"]</h2>
                        <p class="animate fast delay-2ms" data-animation="fastInDown" data-appear-top-offset="250">@Localizer["latest_services_slogan"]</p>
                    </div>
                </div>
                <div class="divider-75"></div>
                <if include-if="(ViewBag.services != null && ViewBag.services.Count > 0)">
                    <div class="row no-gutters">

                        @{ int index = 0; }

                        @foreach (ServiceDto item in ViewBag.services)
                        {
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="service-item text-center">
                                    @{
                                        var animation = activeLang == "ar" ? (index % 2) != 0 ? "interInDownLeft" : "interInDownRight" : ((index % 2) == 0) ? "interInDownLeft" : "interInDownRight";
                                    }

                                    @if (item.IconVisibility)
                                    {
                                        <i class="@(item.Icon.StartsWith("fi")? "fi":"fa") @item.Icon  animate" data-animation="@animation" data-appear-top-offset="250"></i>
                                    }
                                    else if (!string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <img src="@item.MainImage" alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-cubes"></i>
                                    }


                                    <h3 class="service-title">
                                        <strong class="animate" data-animation="fadeIn" data-appear-top-offset="250">@item.Title</strong>
                                    </h3>
                                    <p class="service-text animate" data-animation="fadeInUp" data-appear-top-offset="250"> @item.Summary</p>
                                </div>
                            </div>

                            index++;

                        }
                    </div>

                </if>


            </div>
        </section>

    </if>