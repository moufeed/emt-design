@{
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

}
<section class="  blog-owl overflow-visible blog-featured-posts __dots">

    <div class="container">

        <div class="row">

            <div class="col-12">
                <div class="divider-110 d-none d-xl-block"></div>
                <div class="text-center mb100">
                    <h5 class="animate fast" data-animation="bounceInUp">@Localizer["latest_projects"]  </h5>
                    <p class="animate fast" data-animation="bounceInLeft">@Localizer["latest_events_slogan"]  </p>
                </div>
                <div class="divider-110 d-none d-xl-block"></div>
                <div class="owl-carousel top-right-nav animate fast" data-animation="fadeInUp"
                     data-responsive-lg="3" data-responsive-md="2" data-responsive-sm="2"
                     data-nav="true" data-dots="false" data-loop="false" data-margin="15"
                     data-nav-prev="<i class='fa  @(lang == "ar" ?  "fa-chevron-right"  : "fa-chevron-left")'></i>  "
                     data-nav-next="<i class='fa  @(lang == "ar" ?  "fa-chevron-left"  : "fa-chevron-right") '></i> ">
                    @{
                      
                       List<GalleryLiteDto> projects = (List<GalleryLiteDto>)ViewBag.projects;
                    }
                    <if include-if="ViewBag.projects != null && ViewBag.projects.Count > 0">
                        @foreach (var gallery in projects)
                        {
                            



                            <article class="vertical-item text-center content-padding padding-small ls post type-post status-publish format-standard has-post-thumbnail">
                                <div class="item-media post-thumbnail d-flex justify-content-center align-items-center hight-350 g-item">

                                    <a href="@Url.Action("v","galleries",new{slug= @gallery.Slug })">
                                        @if (string.IsNullOrEmpty(gallery.MainImage))
                                        {
                                            <img src="~/Portal/img/empty.jpg" alt="">
                                        }
                                        else
                                        {
                                            <img src="@gallery.MainImage" alt="@gallery.Title" />
                                        }
                                    </a>
                                </div>
                                <div class="item-content">
                                    <header class="entry-header">
                                        <div class="entry-meta">

                                            <a href="@Url.Action("v","galleries",new{slug=gallery.Slug})">
                                                <time class="entry-date published updated" datetime="@gallery.CreatedDate">

                                                    @gallery.CreatedDate.ToString("MMM/dd/yyyy")
                                                </time>
                                            </a>
                                        </div>
                                        <h6 class="entry-title">
                                            <a href="@Url.Action("v","galleries",new{slug=gallery.Slug})">
                                                @gallery.Title
                                            </a>
                                        </h6>
                                    </header>

                                    <div class="entry-content">
                                        <div class="_3lines">@Html.Raw(gallery.Summary)</div>
                                    </div>

                                </div>
                            </article>
                        }

                    </if>



                </div>
            </div>
        </div>
        <div class="divider-110 d-none d-xl-block"></div>
    </div>
</section>