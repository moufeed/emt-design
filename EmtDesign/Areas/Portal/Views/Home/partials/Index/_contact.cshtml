
<section class="ls s-pt-30 s-pb-100 s-pt-md-100 s-pb-md-130  s-py-lg-100 contact2">
    <div class="divider-15 d-none d-xl-block"></div>
    <div class="container">
       
        <header class="col-12 text-center mb-5">
                <h2 class="animate fast  fadeInLeft" data-animation="fadeInLeft" data-appear-top-offset="250">@Localizer["request_title"]</h2>
                <p class="animate fast delay-2ms  fastInDown" data-animation="fastInDown" data-appear-top-offset="250">@Localizer["request_msg"]</p>
        </header>

        <div class="row">
            <div class="col-lg-12 ">




                <form class="contact-form animate" data-animation="fadeIn" method="post" 
                      action="@Url.Action("ContactUs","home" ,new { Area ="portal" })" id="request_form">

                    <div class="row c-gutter-20">

                        <div class="col-12 col-md-6">
                            <div class="form-group has-placeholder">
                                <label for="name">
                                    @Localizer["p_full_name"]
                                    <span class="required">*</span>
                                </label>
                                <input type="hidden" name="Subject" value="@Localizer["request_title"]" />
                                <input type="text"
                                       aria-required="true"
                                       size="30"
                                       value=""
                                       name="Name"
                                       id="name"
                                       class="form-control text-left flip"
                                       placeholder="@Localizer["p_full_name"]">
                            </div>
                            <div class="form-group has-placeholder ">
                                <label for="email">
                                    @Localizer["p_email_address"]
                                    <span class="required">*</span>
                                </label>
                                <input type="email"
                                       aria-required="true"
                                       size="30" value=""
                                       name="Email" id="email"
                                       class="form-control text-left flip" placeholder="@Localizer["p_email_address"]">
                            </div>
                            <div class="form-group has-placeholder">
                                <label for="subject">
                                    @Localizer["p_phone_number"]
                                    <span class="required">*</span>
                                </label>
                                <input type="text"
                                       aria-required="true"
                                       size="30" value=""
                                       name="Mobile"
                                       id="Mobile"
                                       class="form-control text-left flip"
                                       placeholder="@Localizer["p_phone_number"]">
                            </div>
                        </div>
                        <div class="col-12 col-md-6">

                            <div class="form-group has-placeholder">
                                <label for="message">@Localizer["p_description"]</label>
                                <textarea aria-required="true"
                                          rows="6"
                                          cols="45"
                                          name="Message"
                                          id="message"
                                          class="form-control text-left flip"
                                          placeholder="@Localizer["p_description"]"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group text-center">
                                <button type="submit" id="request_btn" name="contact_submit"
                                        class="btn btn-maincolor btnsend">
                                    <span>@Localizer["request_btn"]</span>
                                    <div class="lds-spinner d-none">
                                        <partial name="~/Areas/Portal/Views/Shared/utilities/_svg_spinner.cshtml" />
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
            <!--.col-* -->
        </div>
    </div>
</section>



